{
  "$schema": "https://opencode.ai/config.json",
  // Local by default: free, offline, no tokens. Switch models in the TUI with /models,
  // or per pane with `hop -m deepseek` (opencode's free hosted DeepSeek V4.1 Flash).
  "model": "ollama/gpt-oss-64k",
  "small_model": "ollama/gpt-oss-64k",
  // Homebrew manages upgrades
  "autoupdate": false,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "gpt-oss-64k": {
          "name": "gpt-oss 20B (local, 64K)",
          "tool_call": true,
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  }
}
