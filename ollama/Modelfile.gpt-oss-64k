# gpt-oss 20B with a 64K context window.
# Ollama's default context on a 24 GB Mac is only 4K, which silently truncates
# agent sessions (Claude Code's system prompt alone is bigger than that).
# Build: ollama create gpt-oss-64k -f ~/dotfiles/ollama/Modelfile.gpt-oss-64k
FROM gpt-oss:20b
PARAMETER num_ctx 65536
