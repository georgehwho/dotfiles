# misc.
alias q='exit'
alias c='clear'
alias fk='fuck'

# cd
alias ~='cd ~'
alias ..='cd ../'
alias ...='cd ../../'
alias ....='cd ../../../'
alias .....='cd ../../../../'

# Agents (Claude Code sets CLAUDECODE=1) expect POSIX ls/grep, not eza/rg, so the
# overrides of standard commands below are for humans only.
AGENT_SHELL=false
[[ -n "$CLAUDECODE" ]] && AGENT_SHELL=true

# ls (eza is the maintained fork of exa)
if command -v eza &> /dev/null && [[ "$AGENT_SHELL" == false ]]
then
    alias ls='eza'
    alias la='eza -aF'
    alias ll='eza -lF'
    alias l='eza -laF --git'
else
    alias ls='ls -GF'
    alias la='ls -aGF'
    alias ll='ls -lGF'
    alias l='ls -laghFG'
fi

# for git aliases
function current_branch() {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || \
  ref=$(git rev-parse --short HEAD 2> /dev/null) || return
  echo ${ref#refs/heads/}
}

# git additions (Oh-My-Zsh git plugin provides the rest)
alias gs='git status'
alias ga.='git add .'
alias gpush='git push origin $(current_branch)'
alias gpull='git pull origin $(current_branch)'
alias gl="git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gll="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --stat"

# grep (use ripgrep for speed)
if command -v rg &> /dev/null
then
    [[ "$AGENT_SHELL" == false ]] && alias grep='rg'
    alias grepi='rg -i'
    alias grepl='rg -l'
fi

# Out of Claude tokens? Same Claude Code (CLAUDE.md, skills, pstack, herdr hook),
# pointed at the local Ollama model. Model aliases (opus/sonnet/haiku) that
# skills and subagents request are all mapped to the local model too.
# Inside herdr, `hop -k claude -m local` opens the same thing in a new pane.
claude-local() {
  curl -sf http://localhost:11434/api/tags > /dev/null || { echo "Ollama isn't running (brew services start ollama)"; return 1; }
  ANTHROPIC_BASE_URL=http://localhost:11434 ANTHROPIC_AUTH_TOKEN=ollama ANTHROPIC_API_KEY="" \
  ANTHROPIC_DEFAULT_OPUS_MODEL=gpt-oss-64k ANTHROPIC_DEFAULT_SONNET_MODEL=gpt-oss-64k \
  ANTHROPIC_DEFAULT_HAIKU_MODEL=gpt-oss-64k ANTHROPIC_DEFAULT_FABLE_MODEL=gpt-oss-64k \
  CLAUDE_CODE_SUBAGENT_MODEL=gpt-oss-64k CLAUDE_CODE_MAX_CONTEXT_TOKENS=65536 \
    claude --model gpt-oss-64k "$@"
}

# speed test stuff
alias myip='curl https://ipinfo.io/json'
alias speedtest='curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -'
